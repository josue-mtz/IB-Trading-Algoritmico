# Copia este archivo como ".env" y ajusta tus valores. NUNCA subas tu ".env" a GitHub.

# Conexión a Interactive Brokers (cuenta DEMO / paper)
# IB Gateway demo usa el puerto 4002; Trader Workstation (TWS) demo usa el 7497.
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID_PRODUCER=1
IB_CLIENT_ID_EXECUTOR=2
# Opcional: solo si necesitas elegir la cuenta explícitamente (empieza con DU).
# IB_ACCOUNT=

# Kafka: dirección del servidor y nombres de los tópicos
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TOPIC_TICKS=ticks
TOPIC_CANDLES=velas
TOPIC_SIGNALS=signals

# Par de divisas y tamaño de la vela (en segundos)
SYMBOL=EURUSD
WINDOW_SECONDS=60

# Estrategia de cruce de EMAs (medias móviles exponenciales)
EMA_FAST=9
EMA_SLOW=21
USE_RSI_FILTER=false
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
USE_TREND_FILTER=false
EMA_TREND_PERIOD=50

# Control de riesgo del ejecutor de órdenes
# Tamaño de cada orden en unidades de la divisa base (10000 = 10,000 EUR).
RISK_TRADE_SIZE=10000
# Distancia del stop-loss y del take-profit, en pips.
RISK_STOP_LOSS_PIPS=10
RISK_TAKE_PROFIT_PIPS=20
# Máximo de posiciones abiertas al mismo tiempo por símbolo.
RISK_MAX_POSITIONS=1
# Algoritmos autorizados (separados por coma). Si usas el dashboard, él elige el algoritmo.
# Si otro equipo quiere usar tu plataforma, agrega aquí su id_algoritmo.
EXECUTOR_ALLOWED_ALGORITHMS=ema_cross_v1

# Backtesting: días a descargar y costos simulados
BACKTEST_DAYS=30
BACKTEST_SPREAD_PIPS=2.0
BACKTEST_SLIPPAGE_PIPS=0.5
BACKTEST_SL_PIPS=10
BACKTEST_TP_PIPS=20

# Dashboard local
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8050
# true = el botón Iniciar también arranca el productor de ticks de IB.
DASHBOARD_MANAGE_PRODUCER=true
# Zona horaria para "ganancia por día" (ej. America/Mexico_City). Vacío = la de tu computadora.
DASHBOARD_TZ=
# Estrategia que el dashboard elige al abrir: v1, v2, v3 o v4.
DEFAULT_VARIANT=v3
