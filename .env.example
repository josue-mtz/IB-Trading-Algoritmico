# Interactive Brokers paper account connection.
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID_PRODUCER=1
IB_CLIENT_ID_EXECUTOR=2
# Set only if the account must be selected explicitly.
# IB_ACCOUNT=

# Kafka topics and local broker address.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TOPIC_TICKS=ticks
TOPIC_CANDLES=velas
TOPIC_SIGNALS=signals

# Market and candle window.
SYMBOL=EURUSD
WINDOW_SECONDS=60

# EMA strategy defaults.
EMA_FAST=9
EMA_SLOW=21
USE_RSI_FILTER=false
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
USE_TREND_FILTER=false
EMA_TREND_PERIOD=50

# Paper-order sizing and risk limits.
RISK_TRADE_SIZE=10000
RISK_STOP_LOSS_PIPS=10
RISK_TAKE_PROFIT_PIPS=20
RISK_MAX_POSITIONS=1
EXECUTOR_ALLOWED_ALGORITHMS=ema_cross_v1

# Historical backtest costs and download range.
BACKTEST_DAYS=30
BACKTEST_SPREAD_PIPS=2.0
BACKTEST_SLIPPAGE_PIPS=0.5
BACKTEST_SL_PIPS=10
BACKTEST_TP_PIPS=20

# Local dashboard.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8050
DASHBOARD_MANAGE_PRODUCER=true
# Leave empty to use the computer's local time zone.
DASHBOARD_TZ=
DEFAULT_VARIANT=v3
